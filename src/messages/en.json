  "aboutUs": {
    "eyebrow": "About Us",
    "title": "About Selasar Bahasa",
    "paragraph1": "Selasar Bahasa is a foreign language learning institution dedicated to helping learners build real-world language skills alongside cultural understanding. We design varied, engaging classroom experiences using relevant teaching media and authentic learning resources. Most importantly, every method and material we use is tailored to the unique needs and goals of each learner.",
    "paragraph2": "Beyond our regular classes, Selasar Bahasa also organizes cultural immersion visits, giving learners the opportunity to interact with native Indonesian speakers while experiencing Indonesian culture and everyday life firsthand. We also offer training and coaching programs for foreign language teachers who want to sharpen their teaching competencies.",
    "paragraph3": "At Selasar Bahasa, we are committed to delivering our very best service so that you can reach your maximum learning goals — and enjoy every step along the way.",
    "signOff": "Warm regards,",
    "signOffName": "The Selasar Bahasa Team"
  },
